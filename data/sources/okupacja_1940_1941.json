  "historical_context": {
    "intro": "Po zajęciu Krakowa we wrześniu 1939 r. miasto ustanowiono 'stolicą' Generalnego Gubernatorstwa. Władze okupacyjne pod kierunkiem Hansa Franka przystąpiły do totalnej germanizacji przestrzeni publicznej, dążąc do zatarcia wielowiekowego polskiego dziedzictwa.",
    "solution": "W latach 1940–1941 wydano urzędowe 'Amtliches Straßenverzeichnis der Stadt Krakau'. Rynek Główny przemianowano na Adolf-Hitler-Platz, Wawel na Krakauer Burg, a ciąg ulic Karmelickiej i Królewskiej na Reichstraße, wokół której zorganizowano zamkniętą dzielnicę dla niemieckich urzędników i wojskowych.",
    "milestone": "Rejestr ten stanowi wstrząsający dokument terroru totalitarnego i próby wymazania polskiej tożsamości narodowej ze stolicy polskich królów."
  },
  "debates": [
    {
      "speaker": "Gubernator Generalny Hans Frank",
      "date": "1940 r.",
      "title": "Przemówienie na Wawelu o 'niemieckim Krakau'",
      "topic": "Dekret o wyrugowaniu polskich nazw z przestrzeni miejskiej",
      "quote": "Kraków z woli Führera staje się niemieckim miastem i stolicą Generalnego Gubernatorstwa. Każda ulica i każdy plac nosić musi miano godne niemieckiej administracji i oręża III Rzeszy.",
      "decision": "Wprowadzono bezwzględny nakaz usunięcia polskich tablic ulicznych i zastąpienia ich niemieckimi napisami gotyckimi."
    }
  ],
